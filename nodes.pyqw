import torch
import numpy as np
import cv2
from PIL import Image
import json
import time
import os
import sys

import folder_paths
from server import PromptServer
from nodes import interrupt_processing

# 全局变量存储姿势文本
CURRENT_POSTURE_TEXTS = {}

# 暂停节点状态
PAUSED_NODES = {}

class PoseAnalyzer:
    @staticmethod
    def analyze_pose_from_json(poses_datas):
        """
        从JSON数据中分析姿态
        """
        if not poses_datas:
            return "未检测到姿态数据"
        
        try:
            pose_data = json.loads(poses_datas)
            if 'people' not in pose_data:
                return "无效的姿态数据格式"
            
            people = pose_data['people']
            if not people:
                return "未检测到人体"
            
            # 提取第一个检测到的人的姿态信息
            person = people[0]
            pose_keypoints = person.get('pose_keypoints_2d', [])
            hand_keypoints = person.get('hand_right_keypoints_2d', []) + person.get('hand_left_keypoints_2d', [])
            face_keypoints = person.get('face_keypoints_2d', [])
            
            # 解析姿态描述
            posture_description = PoseAnalyzer._interpret_pose(pose_keypoints)
            return posture_description
            
        except Exception as e:
            return f"姿态分析错误: {str(e)}"
    
    @staticmethod
    def _interpret_pose(keypoints):
        """
        根据关键点解释姿态
        """
        if len(keypoints) < 54:  # 至少需要18个关键点 (x,y坐标)
            return "姿态数据不足"
        
        # 将关键点转换为坐标列表
        points = [(keypoints[i], keypoints[i+1]) for i in range(0, len(keypoints), 3)]
        
        # 定义身体部位索引
        NOSE = 0
        NECK = 1
        R_SHOULDER = 2
        R_ELBOW = 3
        R_WRIST = 4
        L_SHOULDER = 5
        L_ELBOW = 6
        L_WRIST = 7
        R_HIP = 8
        R_KNEE = 9
        R_ANKLE = 10
        L_HIP = 11
        L_KNEE = 12
        L_ANKLE = 13
        
        # 检查是否所有关键点都有有效值
        valid_points = []
        for i, point in enumerate(points):
            if i < len(points) and point[0] != 0 and point[1] != 0:
                valid_points.append(i)
        
        if len(valid_points) < 5:
            return "姿态数据质量差"
        
        # 分析姿态
        description_parts = []
        
        # 检查手臂位置
        if R_SHOULDER < len(points) and R_ELBOW < len(points) and R_WRIST < len(points):
            right_arm_raised = points[R_SHOULDER][1] > points[R_ELBOW][1] and points[R_ELBOW][1] > points[R_WRIST][1]
            if right_arm_raised:
                description_parts.append("右手抬起")
        
        if L_SHOULDER < len(points) and L_ELBOW < len(points) and L_WRIST < len(points):
            left_arm_raised = points[L_SHOULDER][1] > points[L_ELBOW][1] and points[L_ELBOW][1] > points[L_WRIST][1]
            if left_arm_raised:
                description_parts.append("左手抬起")
        
        # 检查腿部位置
        if R_HIP < len(points) and R_KNEE < len(points) and R_ANKLE < len(points):
            right_leg_bent = abs(points[R_KNEE][1] - points[R_HIP][1]) < abs(points[R_ANKLE][1] - points[R_HIP][1])
            if right_leg_bent:
                description_parts.append("右腿弯曲")
        
        if L_HIP < len(points) and L_KNEE < len(points) and L_ANKLE < len(points):
            left_leg_bent = abs(points[L_KNEE][1] - points[L_HIP][1]) < abs(points[L_ANKLE][1] - points[L_HIP][1])
            if left_leg_bent:
                description_parts.append("左腿弯曲")
        
        # 检查身体朝向
        shoulder_diff = abs(points[R_SHOULDER][0] - points[L_SHOULDER][0]) if R_SHOULDER < len(points) and L_SHOULDER < len(points) else 0
        hip_diff = abs(points[R_HIP][0] - points[L_HIP][0]) if R_HIP < len(points) and L_HIP < len(points) else 0
        
        if shoulder_diff > hip_diff * 1.5:
            description_parts.append("正面")
        elif shoulder_diff < hip_diff * 0.7:
            description_parts.append("侧面")
        else:
            description_parts.append("半侧面")
        
        # 组合描述
        if description_parts:
            return ", ".join(description_parts)
        else:
            return "标准站立姿势"

class OpenPoseEditor:
    def __init__(self):
        pass

    @classmethod
    def INPUT_TYPES(cls):
        return {
            "required": {
                "image": ("IMAGE",),
                "output_width_for_dwpose": ("INT", {"default": 512, "min": 64, "max": 2048}),
                "output_height_for_dwpose": ("INT", {"default": 512, "min": 64, "max": 2048}),
                "scale_for_xinsr_for_dwpose": ("FLOAT", {"default": 1.0, "min": 0.1, "max": 10.0}),
                "stop_for_edit": ("BOOLEAN", {"default": False}),
                "poses_datas": ("STRING", {"multiline": True, "default": ""})
            },
            "optional": {
                "bridge_anything": (["Bridge"],),
                "prev_image": ("IMAGE",),
                "pose_image": ("IMAGE",),
                "pose_point": ("POSE_POINT",),
                "unique_id": ("STRING", {"default": "", "forceInput": True}),
                "backgroundImage": ("STRING", {"default": ""})
            }
        }

    RETURN_TYPES = ("IMAGE", "IMAGE", "IMAGE", "IMAGE", "INT", "INT", "STRING")
    RETURN_NAMES = ("dw_pose_image", "dw_combined_image", "pose_3d_image", "pose_2d_image", 
                   "output_width", "output_height", "posture_description")
    FUNCTION = "get_images"
    CATEGORY = "3D_OpenPose_Editor"

    def pose_point_to_json(self, pose_point, pose_image):
        """
        将姿态点转换为JSON格式
        """
        # 这里应该实现将姿态点转换为OpenPose JSON格式的逻辑
        # 简化示例，实际实现可能需要更复杂的处理
        if pose_point and pose_image is not None:
            # 创建基本的OpenPose JSON结构
            pose_json = {
                "version": 1.0,
                "people": [
                    {
                        "person_id": [0],
                        "pose_keypoints_2d": pose_point,
                        "face_keypoints_2d": [],
                        "hand_left_keypoints_2d": [],
                        "hand_right_keypoints_2d": []
                    }
                ],
                "width": pose_image.shape[2] if len(pose_image.shape) > 1 else 512,
                "height": pose_image.shape[1] if len(pose_image.shape) > 0 else 512
            }
            return json.dumps(pose_json)
        return ""

    def render_dw_pose(self, poses_datas, width, height, scale):
        """
        渲染DWPose图像
        """
        # 创建占位图像
        img = np.zeros((height, width, 3), dtype=np.uint8)
        img.fill(255)  # 白色背景
        
        if not poses_datas:
            return img
        
        try:
            pose_data = json.loads(poses_datas)
            people = pose_data.get('people', [])
            
            if people:
                person = people[0]
                keypoints = person.get('pose_keypoints_2d', [])
                
                # 绘制关键点和连接线
                if keypoints:
                    points = [(int(keypoints[i]), int(keypoints[i+1])) for i in range(0, len(keypoints), 3) if i+1 < len(keypoints)]
                    
                    # 绘制骨架连接线
                    connections = [
                        (0, 1), (1, 2), (2, 3), (3, 4), (1, 5), (5, 6), (6, 7),
                        (1, 8), (8, 9), (9, 10), (1, 11), (11, 12), (12, 13)
                    ]
                    
                    for start_idx, end_idx in connections:
                        if start_idx < len(points) and end_idx < len(points):
                            start_point = points[start_idx]
                            end_point = points[end_idx]
                            cv2.line(img, start_point, end_point, (0, 0, 0), 2)
                    
                    # 绘制关键点
                    for point in points:
                        cv2.circle(img, point, 3, (0, 0, 255), -1)
        except:
            pass
        
        return img

    def get_images(self, image, output_width_for_dwpose, output_height_for_dwpose, 
                   scale_for_xinsr_for_dwpose, stop_for_edit, poses_datas,
                   bridge_anything=None, prev_image=None, pose_image=None, pose_point=None,
                   unique_id=None, backgroundImage=""):

        # 参数默认值
        if backgroundImage is None:
            backgroundImage = ""
        if poses_datas is None:
            poses_datas = ""

        node_str_id = str(unique_id) if unique_id else ""

        # 从 pose_point 生成 poses_datas
        if pose_image is not None and pose_point is not None:
            temp_poses_datas = self.pose_point_to_json(pose_point, pose_image)
            if temp_poses_datas:
                poses_datas = temp_poses_datas

        # 更新尺寸
        if poses_datas:
            try:
                pd = json.loads(poses_datas)
                output_width_for_dwpose = pd.get("width", output_width_for_dwpose)
                output_height_for_dwpose = pd.get("height", output_height_for_dwpose)
            except:
                pass

        # 暂停逻辑（保留）
        if stop_for_edit and unique_id:
            node_str_id = str(unique_id)
            PAUSED_NODES[node_str_id] = {'status': 'waiting', 'initial_data': poses_datas}
            PromptServer.instance.send_sync("openpose_node_pause", {
                "node_id": node_str_id,
                "current_pose": poses_datas,
                "current_background_image": backgroundImage
            })
            
            while True:
                if node_str_id not in PAUSED_NODES:
                    break
                state = PAUSED_NODES[node_str_id]
                status = state.get('status')

                if status == 'resume':
                    new_pose_data = state.get('data')
                    if new_pose_data:
                        poses_datas = new_pose_data
                        try:
                            pd = json.loads(new_pose_data)
                            output_width_for_dwpose = pd.get("width", output_width_for_dwpose)
                            output_height_for_dwpose = pd.get("height", output_height_for_dwpose)
                        except:
                            pass
                    del PAUSED_NODES[node_str_id]
                    break
                elif status == 'cancel':
                    del PAUSED_NODES[node_str_id]
                    interrupt_processing()
                    # 返回正确的张量形状
                    empty_tensor = torch.zeros((1, output_height_for_dwpose, output_width_for_dwpose, 3), dtype=torch.float32)
                    return (empty_tensor, empty_tensor, empty_tensor, empty_tensor, 
                           output_width_for_dwpose, output_height_for_dwpose, "已取消")
                time.sleep(0.1)

        # 渲染 DWPose
        dw_pose_np = self.render_dw_pose(poses_datas, output_width_for_dwpose, 
                                          output_height_for_dwpose, scale_for_xinsr_for_dwpose)
        dw_pose_image = torch.from_numpy(dw_pose_np.astype(np.float32) / 255.0).unsqueeze(0)

        # 合成图
        dw_combined_image = dw_pose_image.clone()
        if backgroundImage and backgroundImage.strip():
            bg_path = folder_paths.get_annotated_filepath(backgroundImage)
            if os.path.exists(bg_path):
                try:
                    bg_pil = Image.open(bg_path).convert("RGB")
                    bg_np = np.array(bg_pil)
                    bg_resized = cv2.resize(bg_np, (output_width_for_dwpose, output_height_for_dwpose))
                    dw_gray = cv2.cvtColor(dw_pose_np, cv2.COLOR_RGB2GRAY)
                    _, mask = cv2.threshold(dw_gray, 1, 255, cv2.THRESH_BINARY)
                    combined = bg_resized.copy()
                    combined[mask != 0] = dw_pose_np[mask != 0]
                    dw_combined_image = torch.from_numpy(combined.astype(np.float32) / 255.0).unsqueeze(0)
                except:
                    pass

        # 3D 和 2D 图
        pose_3d_image = dw_pose_image.clone()
        pose_2d_image = dw_pose_image.clone()

        # ========== 修改这里：优先使用前端提供的准确姿势描述 ==========
        # 首先检查全局存储中是否有前端发送的准确姿势描述
        if node_str_id and node_str_id in CURRENT_POSTURE_TEXTS:
            posture_text = CURRENT_POSTURE_TEXTS[node_str_id]
        else:
            # 如果没有前端数据，则使用后端分析
            posture_text = PoseAnalyzer.analyze_pose_from_json(poses_datas)

        # 保存到全局字典以供后续使用
        if node_str_id:
            CURRENT_POSTURE_TEXTS[node_str_id] = posture_text

        # 构建 UI 数据
        ui_data = {
            "poses_datas": [poses_datas],
            "editdPose": [""],
            "inputPose": [""],
            "backgroundImage": [backgroundImage],
            "refresh_trigger": [str(int(time.time() * 1000))],
            "dw_pose_shape": [list(dw_pose_image.shape)],
            "combined_shape": [list(dw_combined_image.shape)],
            "dw_pose_width": [output_width_for_dwpose],
            "dw_pose_height": [output_height_for_dwpose]
        }
        
        return {
            "ui": ui_data,
            "result": (dw_pose_image, dw_combined_image, pose_3d_image, pose_2d_image,
                       output_width_for_dwpose, output_height_for_dwpose, posture_text)
        }

# 注册节点类
NODE_CLASS_MAPPINGS = {
    "OpenPoseEditor": OpenPoseEditor,
}

NODE_DISPLAY_NAME_MAPPINGS = {
    "OpenPoseEditor": "OpenPose Editor",
}